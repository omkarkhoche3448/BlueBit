# Environment variables for BlueBit application
# Database Configuration
DATABASE_URL=postgresql://username:password@localhost:5432/bluebit
# NEON_CONNECTION_STRING=postgres://user:password@endpoint/neondb

# Application Ports
APP_PORT=8000
MICROSERVICE_PORT=5000
# Base URL for the application (used in emails)
BASE_URL=http://127.0.0.1:8000

# Email Configuration
SMTP_SERVER=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=youremail@gmail.com
SMTP_PASSWORD=your-app-password
FROM_EMAIL=youremail@gmail.com

# API Configuration
API_SECRET_KEY=your-secret-key-here

# Cashfree Payment Configuration
CASHFREE_APP_ID=your-cashfree-app-id
CASHFREE_SECRET_KEY=your-cashfree-secret-key
CASHFREE_ENV=TEST

# Gemini API Configuration
GEMINI_API_KEY=your-gemini-api-key

# Environment-specific settings
ENVIRONMENT=development
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# Resume upload configuration
RESUME_UPLOAD_FOLDER=resume
