{
    "manifest_version": 3,
    "name": "AI Job Application Autofill",
    "version": "1.0",
    "description": "Automatically fills job application forms using AI and your resume data",
    "permissions": [
      "activeTab",
      "storage",
      "scripting"
    ],
    "host_permissions": [
      "<all_urls>"
    ],
    "action": {
      "default_popup": "popup/popup.html",
      "default_icon": {      
        "16": "icons/2XKygdwaxoET6fuD04meDvBLYpE-desktop.jpg"

      }
    },
    "background": {
      "service_worker": "scripts/background.js"
    },
    "content_scripts": [
      {
        "matches": ["<all_urls>"],
        "js": ["utils/formFieldExtractor.js", "scripts/content.js"]
      }
    ],
    "icons": {
      "16": "icons/2XKygdwaxoET6fuD04meDvBLYpE-desktop.jpg"
    }
  }