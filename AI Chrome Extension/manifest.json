{
  "manifest_version": 3,
  "name": "AI Job Application Autofill",
  "version": "1.0",
  "description": "Automatically fills job application forms using AI and your resume data",
  "permissions": [
    "activeTab",
    "storage",
    "scripting",
    "tabs"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "action": {
    "default_popup": "popup/popup.html",
    "default_icon": {      
      "16": "icons/2XKygdwaxoET6fuD04meDvBLYpE-desktop.jpg"
    }
  },
  "background": {
    "service_worker": "scripts/background.js"
  },
  "icons": {
    "16": "icons/2XKygdwaxoET6fuD04meDvBLYpE-desktop.jpg"
  },
  "web_accessible_resources": [
    {
      "resources": ["scripts/*", "utils/*"],
      "matches": ["<all_urls>"]
    }
  ]
}